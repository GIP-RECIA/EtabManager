{
  "name": "etab-manager",
  "type": "module",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "dev": "dotenv-checker && vite --host",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "npx playwright install && playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint src/main/webapp/src/",
    "postinstall": "husky",
    "changelog:generate": "commit-and-tag-version --packageFiles pom.xml --skip.bump --skip.tag --skip.commit -t ''"
  },
  "dependencies": {
    "@pinia/colada": "^1.4.2",
    "@tanstack/vue-table": "^9.2.4",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.19.0",
    "pinia": "^4.0.2",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.0",
    "vuetify": "^3.12.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@date-io/date-fns": "^3.2.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@gip-recia/ui": "^1.0.5",
    "@gip-recia/ui-webcomponents": "^1.18.1",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@juggle/resize-observer": "^3.4.0",
    "@pinia/colada-devtools": "^1.1.2",
    "@pinia/testing": "^2.0.1",
    "@playwright/test": "^1.62.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30",
    "@types/lodash-es": "^4",
    "@types/node": "^24",
    "@types/xml2js": "^0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-dom": "^3.5.40",
    "@vue/devtools-api": "^8.2.1",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "commit-and-tag-version": "^13.1.2",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "dotenv-checker": "^1.1.7",
    "eslint": "^10.9.1",
    "eslint-plugin-format": "^2.0.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "lodash-es": "^4.18.1",
    "npm-run-all2": "^9.0.3",
    "ress": "^6.0.0",
    "sass": "^1.103.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11",
    "vue3-toastify": "^0.2.9",
    "xml2js": "^0.6.2"
  }
}
